# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
schema-snapshot.json

# next-pwa build output -- generated fresh by every `next build` (see
# next.config.ts's workboxOptions). Committing these would either be
# instantly stale or, worse, look like real hand-written source that a
# future engineer or agent edits directly -- exactly the confusion this
# session traced a real bug back to. Source of truth is next.config.ts
# and worker/index.js, not these generated files.
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
public/worker-*.js.map
