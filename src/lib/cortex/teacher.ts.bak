/**
 * /lib/cortex/teacher.ts
 *
 * TeacherAI: Tutoring-style AI provider for complex questions
 *
 * Responsibility:
 * - Call external AI APIs (OpenAI, Gemini, Cloudflare, OpenRouter)
 * - Apply tutoring-focused system prompt
 * - Return clean string responses
 * - No routing logic (router handles that)
 *
 * Design:
 * - Follows existing codebase pattern (fallback chain)
 * - Uses gpt-4o-mini as primary (fast, capable)
 * - Graceful fallback to other providers
 * - Tutoring tone: explanatory, not just answers
 */

/**
 * TeacherAI system prompt: Educational, tutoring-focused
 * Emphasizes understanding over memorization
 */
const TEACHER_SYSTEM_PROMPT = `You are a knowledgeable and patient tutor within Shadecode Student, an educational platform for students.

Your role:
- Explain concepts clearly and pedagogically
- Break complex topics into digestible steps
- Ask guiding questions to check understanding
- Encourage critical thinking
- Provide concrete examples
- Admit when you're uncertain

Tone:
- Conversational but professional
- Supportive and encouraging
- Educational, not just informative
- Concise but thorough

Do not:
- Give complete answers without explanation
- Assume prior knowledge
- Use jargon without defining it
- Provide homework solutions directly
- Motivate with pressure or urgency`;

import { fetchWithRetry } from "@/lib/fetchWithRetry";

/**
 * TeacherAI: Complex question AI provider
 *
 * Flow:
 * 1. Build prompt with system context
 * 2. Try OpenAI (fast, reliable)
 * 3. Fall back to Gemini
 * 4. Fall back to Cloudflare
 * 5. Fall back to OpenRouter
 * 6. Return error message if all fail
 */
export class TeacherAI {
  /**
   * Generate response to a complex question
   *
   * @param question - User question
   * @param context - Optional context data
   * @returns Clean string response
   */
  async generateResponse(
    question: string,
    context?: Record<string, unknown>
  ): Promise<string> {
    try {
      const prompt = this.buildPrompt(question, context);
      const response = await this.callAIChain(prompt);

      if (response) {
        return this.cleanResponse(response);
      }

      return this.getFallbackResponse(question);
    } catch (error) {
      console.error("[TeacherAI] Error:", error);
      return this.getFallbackResponse(question);
    }
  }

  /**
   * Build prompt from question and context
   *
   * @param question - User question
   * @param context - Optional context
   * @returns Formatted prompt
   */
  private buildPrompt(
    question: string,
    context?: Record<string, unknown>
  ): string {
    let prompt = `${TEACHER_SYSTEM_PROMPT}\n\n---\n\nStudent Question: ${question}`;

    if (context) {
      const contextStr = Object.entries(context)
        .filter(([, v]) => v !== null && v !== undefined)
        .map(([k, v]) => `${k}: ${JSON.stringify(v)}`)
        .join("\n");

      if (contextStr) {
        prompt += `\n\nContext:\n${contextStr}`;
      }
    }

    return prompt;
  }

  /**
   * AI provider fallback chain
   * Tries providers in order of preference
   *
   * @param prompt - Full prompt
   * @returns Response or null if all fail
   */
  private async callAIChain(prompt: string): Promise<string | null> {
    // 1. OpenAI (primary)
    const openaiResult = await this.callOpenAI(prompt);
    if (openaiResult) return openaiResult;

    // 2. Gemini (secondary)
    const geminiResult = await this.callGemini(prompt);
    if (geminiResult) return geminiResult;

    // 3. Cloudflare Workers AI (tertiary)
    const cfResult = await this.callCloudflare(prompt);
    if (cfResult) return cfResult;

    // 4. OpenRouter (fallback)
    const orResult = await this.callOpenRouter(prompt);
    if (orResult) return orResult;

    return null;
  }

  /**
   * Call OpenAI API (gpt-4o-mini)
   *
   * @param prompt - Full prompt
   * @returns Response or null
   */
  private async callOpenAI(prompt: string): Promise<string | null> {
    if (!process.env.OPENAI_API_KEY) {
      return null;
    }

    try {
      const response = await fetch("https://api.openai.com/v1/chat/completions", {
        method: "POST",
        headers: {
          Authorization: `Bearer ${process.env.OPENAI_API_KEY}`,
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          model: "gpt-4o-mini",
          messages: [
            {
              role: "system",
              content: TEACHER_SYSTEM_PROMPT,
            },
            {
              role: "user",
              content: prompt.replace(TEACHER_SYSTEM_PROMPT, "").trim(),
            },
          ],
          max_tokens: 1500,
          temperature: 0.7,
        }),
      });

      const data = (await response.json()) as {
        choices?: Array<{ message?: { content?: string } }>;
      };
      const text = data.choices?.[0]?.message?.content;

      if (text) {
        console.log("[TeacherAI] Success with OpenAI");
        return text;
      }

      return null;
    } catch (error) {
      console.error("[TeacherAI] OpenAI failed:", error);
      return null;
    }
  }

  /**
   * Call Gemini API (multi-model, multi-key fallback)
   *
   * @param prompt - Full prompt
   * @returns Response or null
   */
  private async callGemini(prompt: string): Promise<string | null> {
    const geminiKeys = [
      process.env.GEMINI_API_KEY,
      process.env.GEMINI_API_KEY_2,
      process.env.GEMINI_API_KEY_3,
    ].filter((k) => k) as string[];

    if (geminiKeys.length === 0) {
      return null;
    }

    const models = ["gemini-2.5-flash", "gemini-2.0-flash"];

    for (const key of geminiKeys) {
      for (const model of models) {
        try {
          const response = await fetch(
            `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${key}`,
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                contents: [
                  {
                    parts: [
                      {
                        text: prompt,
                      },
                    ],
                  },
                ],
                generationConfig: {
                  maxOutputTokens: 1500,
                  temperature: 0.7,
                },
              }),
            }
          );

          const data = (await response.json()) as {
            candidates?: Array<{
              content?: { parts?: Array<{ text?: string }> };
            }>;
          };
          const text = data.candidates?.[0]?.content?.parts?.[0]?.text;

          if (text) {
            console.log(`[TeacherAI] Success with Gemini (${model})`);
            return text;
          }
        } catch (error) {
          console.error(`[TeacherAI] Gemini (${model}) failed:`, error);
        }
      }
    }

    return null;
  }

  /**
   * Call Cloudflare Workers AI (Llama 3.3 70B)
   *
   * @param prompt - Full prompt
   * @returns Response or null
   */
  private async callCloudflare(prompt: string): Promise<string | null> {
    if (!process.env.CLOUDFLARE_API_TOKEN) {
      return null;
    }

    const CF_ACCOUNT = "6a119f6052c02197d301e50f0d4a56cc";

    try {
      const response = await fetch(
        `https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT}/ai/run/@cf/meta/llama-3.3-70b-instruct-fp8-fast`,
        {
          method: "POST",
          headers: {
            Authorization: `Bearer ${process.env.CLOUDFLARE_API_TOKEN}`,
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            messages: [
              {
                role: "system",
                content: TEACHER_SYSTEM_PROMPT,
              },
              {
                role: "user",
                content: prompt.replace(TEACHER_SYSTEM_PROMPT, "").trim(),
              },
            ],
            max_tokens: 1500,
          }),
        }
      );

      const data = (await response.json()) as {
        result?: { response?: string };
      };
      const text = data.result?.response;

      if (text && typeof text === "string") {
        console.log("[TeacherAI] Success with Cloudflare");
        return text;
      }

      return null;
    } catch (error) {
      console.error("[TeacherAI] Cloudflare failed:", error);
      return null;
    }
  }

  /**
   * Call OpenRouter API (Llama 3.3 free fallback)
   *
   * @param prompt - Full prompt
   * @returns Response or null
   */
  private async callOpenRouter(prompt: string): Promise<string | null> {
    if (!process.env.OPENROUTER_API_KEY) {
      return null;
    }

    try {
      const response = await fetch("https://openrouter.ai/api/v1/chat/completions", {
        method: "POST",
        headers: {
          Authorization: `Bearer ${process.env.OPENROUTER_API_KEY}`,
          "Content-Type": "application/json",
          "HTTP-Referer": "https://shadecodestudent.vercel.app",
        },
        body: JSON.stringify({
          model: "meta-llama/llama-3.3-70b-instruct:free",
          messages: [
            {
              role: "system",
              content: TEACHER_SYSTEM_PROMPT,
            },
            {
              role: "user",
              content: prompt.replace(TEACHER_SYSTEM_PROMPT, "").trim(),
            },
          ],
          max_tokens: 1500,
          temperature: 0.7,
        }),
      });

      const data = (await response.json()) as {
        choices?: Array<{ message?: { content?: string } }>;
      };
      const text = data.choices?.[0]?.message?.content;

      if (text) {
        console.log("[TeacherAI] Success with OpenRouter");
        return text;
      }

      return null;
    } catch (error) {
      console.error("[TeacherAI] OpenRouter failed:", error);
      return null;
    }
  }

  /**
   * Clean response: trim, remove code fences, normalize whitespace
   *
   * @param response - Raw response
   * @returns Cleaned response
   */
  private cleanResponse(response: string): string {
    return response
      .trim()
      .replace(/^```[\w]*\n?/gi, "") // Remove opening code fence
      .replace(/\n?```$/gi, "") // Remove closing code fence
      .replace(/\s+/g, " ") // Normalize whitespace
      .trim();
  }

  /**
   * Fallback response if all providers fail
   *
   * @param question - Original question
   * @returns Helpful fallback message
   */
  private getFallbackResponse(question: string): string {
    return `I'm having trouble connecting to my tutoring services right now. Here's what I can tell you: Your question about "${question.slice(0, 50)}${question.length > 50 ? "..." : ""}" is a great one to explore. I recommend:\n\n1. Try again in a moment\n2. Check your internet connection\n3. Break down the question into smaller parts\n\nWhen services are restored, I'll be able to give you a detailed explanation.`;
  }
}

/**
 * Default singleton instance
 */
export const teacherAI = new TeacherAI();
